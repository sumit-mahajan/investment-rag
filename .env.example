# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Database (Neon / Postgres — POSTGRES_URL connection string)
POSTGRES_URL=

# Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=

# Embeddings (Google Gemini)
GOOGLE_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=50

# Chunking
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# LLM (Groq) — used in analysis pipeline
GROQ_API_KEY=

# LlamaParse — get API key at https://cloud.llamaindex.ai (API Keys → Create new key)
LLAMA_CLOUD_API_KEY=
# Tier: fast (cheapest) | cost_effective (default) | agentic | agentic_plus (best, paid)
LLAMA_PARSE_TIER=cost_effective
LLAMA_PARSE_VERSION=latest

# LangSmith — enable for dev tracing and RAGAS evaluation (scripts/evaluate-rag.ts)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=investment-rag
# Show trace link in analysis UI (developer only; default off in production)
SHOW_LANGSMITH_TRACE=false
